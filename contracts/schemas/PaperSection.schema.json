{
  "$defs": {
    "ItemInstance": {
      "additionalProperties": false,
      "description": "Frozen paper item with resolved parameters, score, and evidence links.",
      "properties": {
        "concept_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "item_instance_id": {
          "minLength": 1,
          "title": "Item Instance Id",
          "type": "string"
        },
        "item_version": {
          "minLength": 1,
          "title": "Item Version",
          "type": "string"
        },
        "max_score": {
          "minimum": 0.0,
          "title": "Max Score",
          "type": "number"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "rubric_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rubric Id"
        },
        "rubric_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Version"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "stem": {
          "minLength": 1,
          "title": "Stem",
          "type": "string"
        }
      },
      "required": [
        "item_instance_id",
        "item_id",
        "item_version",
        "stem",
        "parameters",
        "concept_ids",
        "rubric_id",
        "max_score",
        "source_evidence_ids"
      ],
      "title": "ItemInstance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One paper section whose declared score equals its item maxima.",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ItemInstance"
      },
      "title": "Items",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "minimum": 0.0,
      "title": "Score",
      "type": "number"
    },
    "section_id": {
      "minLength": 1,
      "title": "Section Id",
      "type": "string"
    }
  },
  "required": [
    "section_id",
    "name",
    "items",
    "score"
  ],
  "title": "PaperSection",
  "type": "object"
}
