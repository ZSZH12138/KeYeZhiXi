{
  "additionalProperties": false,
  "description": "Learner ability estimate bound to one IRT parameter set.",
  "properties": {
    "estimate_id": {
      "minLength": 1,
      "title": "Estimate Id",
      "type": "string"
    },
    "estimated_at": {
      "format": "date-time",
      "title": "Estimated At",
      "type": "string"
    },
    "learner_id": {
      "minLength": 1,
      "title": "Learner Id",
      "type": "string"
    },
    "parameter_set_id": {
      "minLength": 1,
      "title": "Parameter Set Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "standard_error": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Standard Error"
    },
    "status": {
      "enum": [
        "empty",
        "estimated",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "theta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Theta"
    }
  },
  "required": [
    "estimate_id",
    "learner_id",
    "parameter_set_id",
    "status",
    "estimated_at"
  ],
  "title": "AbilityEstimate",
  "type": "object"
}
