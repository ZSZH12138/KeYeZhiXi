{
  "additionalProperties": false,
  "description": "Path-free teacher review form accepted by M0 and consumed by M9.",
  "properties": {
    "audit_id": {
      "minLength": 1,
      "title": "Audit Id",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approve",
        "override",
        "reject"
      ],
      "title": "Decision",
      "type": "string"
    },
    "expected_audit_version": {
      "minimum": 1,
      "title": "Expected Audit Version",
      "type": "integer"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "submission_id": {
      "minLength": 1,
      "title": "Submission Id",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    }
  },
  "required": [
    "submission_id",
    "audit_id",
    "expected_audit_version",
    "reviewer_id",
    "decision",
    "submitted_at"
  ],
  "title": "TeacherReviewSubmission",
  "type": "object"
}
