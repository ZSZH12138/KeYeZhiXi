{
  "additionalProperties": false,
  "description": "M9 evidence gate for a model or parameter version.",
  "properties": {
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "observation_count": {
      "minimum": 0,
      "title": "Observation Count",
      "type": "integer"
    },
    "report_id": {
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "insufficient_data",
        "ready",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject_ref": {
      "minLength": 1,
      "title": "Subject Ref",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "subject_ref",
    "metrics",
    "observation_count",
    "status",
    "generated_at"
  ],
  "title": "ModelQualityReport",
  "type": "object"
}
