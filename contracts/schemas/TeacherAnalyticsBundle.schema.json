{
  "$defs": {
    "ClassConceptStatus": {
      "additionalProperties": false,
      "description": "Aggregated class evidence for one concept.",
      "properties": {
        "concept_id": {
          "minLength": 1,
          "title": "Concept Id",
          "type": "string"
        },
        "mastery_distribution": {
          "$ref": "#/$defs/MasteryDistribution"
        },
        "mastery_trend_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mastery Trend Delta"
        },
        "mean_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Confidence",
          "type": "number"
        },
        "mean_mastery_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Mastery Probability",
          "type": "number"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trend_comparable": {
          "title": "Trend Comparable",
          "type": "boolean"
        }
      },
      "required": [
        "concept_id",
        "mastery_distribution",
        "mean_mastery_probability",
        "mean_confidence",
        "mastery_trend_delta",
        "trend_comparable",
        "sample_count"
      ],
      "title": "ClassConceptStatus",
      "type": "object"
    },
    "ClassMisconceptionSummary": {
      "additionalProperties": false,
      "description": "Aggregated prevalence of one misconception in assessed learners.",
      "properties": {
        "affected_count": {
          "minimum": 0,
          "title": "Affected Count",
          "type": "integer"
        },
        "affected_rate_among_assessed": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Affected Rate Among Assessed",
          "type": "number"
        },
        "evidence_attempts": {
          "minimum": 0,
          "title": "Evidence Attempts",
          "type": "integer"
        },
        "misconception_id": {
          "minLength": 1,
          "title": "Misconception Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "misconception_id",
        "affected_count",
        "affected_rate_among_assessed",
        "evidence_attempts"
      ],
      "title": "ClassMisconceptionSummary",
      "type": "object"
    },
    "ClassReport": {
      "additionalProperties": false,
      "description": "Teacher-facing class report with explicit evidence coverage.",
      "properties": {
        "class_id": {
          "minLength": 1,
          "title": "Class Id",
          "type": "string"
        },
        "concept_summaries": {
          "items": {
            "$ref": "#/$defs/ClassConceptStatus"
          },
          "title": "Concept Summaries",
          "type": "array"
        },
        "coverage_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage Rate",
          "type": "number"
        },
        "evidence_status": {
          "minLength": 1,
          "title": "Evidence Status",
          "type": "string"
        },
        "misconception_summaries": {
          "items": {
            "$ref": "#/$defs/ClassMisconceptionSummary"
          },
          "title": "Misconception Summaries",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score_statistics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Score Statistics",
          "type": "object"
        }
      },
      "required": [
        "class_id",
        "coverage_rate",
        "concept_summaries",
        "misconception_summaries",
        "score_statistics",
        "evidence_status"
      ],
      "title": "ClassReport",
      "type": "object"
    },
    "IndividualReport": {
      "additionalProperties": false,
      "description": "Teacher-facing learner summary for targeted follow-up.",
      "properties": {
        "active_misconception_ids": {
          "items": {
            "type": "string"
          },
          "title": "Active Misconception Ids",
          "type": "array"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "overall_mastery": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overall Mastery",
          "type": "number"
        },
        "recent_score": {
          "minimum": 0.0,
          "title": "Recent Score",
          "type": "number"
        },
        "review_required_count": {
          "minimum": 0,
          "title": "Review Required Count",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "weak_concept_ids": {
          "items": {
            "type": "string"
          },
          "title": "Weak Concept Ids",
          "type": "array"
        }
      },
      "required": [
        "learner_id",
        "overall_mastery",
        "weak_concept_ids",
        "active_misconception_ids",
        "recent_score",
        "review_required_count"
      ],
      "title": "IndividualReport",
      "type": "object"
    },
    "MasteryDistribution": {
      "additionalProperties": false,
      "description": "Normalized class proportions across the three mastery bands.",
      "properties": {
        "consolidating": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Consolidating",
          "type": "number"
        },
        "mastered": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mastered",
          "type": "number"
        },
        "priority_support": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Priority Support",
          "type": "number"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "mastered",
        "consolidating",
        "priority_support"
      ],
      "title": "MasteryDistribution",
      "type": "object"
    },
    "ReviewQueueItem": {
      "additionalProperties": false,
      "description": "One version-bound score audit waiting for teacher attention.",
      "properties": {
        "audit_id": {
          "minLength": 1,
          "title": "Audit Id",
          "type": "string"
        },
        "audit_version": {
          "minimum": 1,
          "title": "Audit Version",
          "type": "integer"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "item_instance_id": {
          "minLength": 1,
          "title": "Item Instance Id",
          "type": "string"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "recommended_score": {
          "minimum": 0.0,
          "title": "Recommended Score",
          "type": "number"
        },
        "review_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "audit_id",
        "audit_version",
        "learner_id",
        "item_instance_id",
        "recommended_score",
        "confidence",
        "review_reasons"
      ],
      "title": "ReviewQueueItem",
      "type": "object"
    },
    "TeachingSuggestion": {
      "additionalProperties": false,
      "description": "Evidence-thresholded class teaching recommendation.",
      "properties": {
        "action_type": {
          "minLength": 1,
          "title": "Action Type",
          "type": "string"
        },
        "affected_count": {
          "minimum": 0,
          "title": "Affected Count",
          "type": "integer"
        },
        "affected_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Affected Rate",
          "type": "number"
        },
        "concept_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "coverage_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage Rate",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "suggestion_id": {
          "minLength": 1,
          "title": "Suggestion Id",
          "type": "string"
        },
        "trigger_metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Trigger Metrics",
          "type": "object"
        }
      },
      "required": [
        "suggestion_id",
        "action_type",
        "concept_ids",
        "content",
        "trigger_metrics",
        "affected_count",
        "affected_rate",
        "coverage_rate",
        "confidence",
        "evidence_ids",
        "status"
      ],
      "title": "TeachingSuggestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete class, learner, review, and suggestion analytics payload.",
  "properties": {
    "class_report": {
      "$ref": "#/$defs/ClassReport"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "individual_reports": {
      "items": {
        "$ref": "#/$defs/IndividualReport"
      },
      "title": "Individual Reports",
      "type": "array"
    },
    "report_id": {
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "review_queue": {
      "items": {
        "$ref": "#/$defs/ReviewQueueItem"
      },
      "title": "Review Queue",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "teaching_suggestions": {
      "items": {
        "$ref": "#/$defs/TeachingSuggestion"
      },
      "title": "Teaching Suggestions",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "class_report",
    "individual_reports",
    "review_queue",
    "teaching_suggestions",
    "generated_at"
  ],
  "title": "TeacherAnalyticsBundle",
  "type": "object"
}
