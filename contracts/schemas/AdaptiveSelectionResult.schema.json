{
  "$defs": {
    "AbilityEstimate": {
      "additionalProperties": false,
      "description": "Learner ability estimate bound to one IRT parameter set.",
      "properties": {
        "estimate_id": {
          "minLength": 1,
          "title": "Estimate Id",
          "type": "string"
        },
        "estimated_at": {
          "format": "date-time",
          "title": "Estimated At",
          "type": "string"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "parameter_set_id": {
          "minLength": 1,
          "title": "Parameter Set Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "standard_error": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Error"
        },
        "status": {
          "enum": [
            "empty",
            "estimated",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "theta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theta"
        }
      },
      "required": [
        "estimate_id",
        "learner_id",
        "parameter_set_id",
        "status",
        "estimated_at"
      ],
      "title": "AbilityEstimate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "M8 item selection output; empty until IRT is configured.",
  "properties": {
    "ability_estimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/AbilityEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "item_ids": {
      "items": {
        "type": "string"
      },
      "title": "Item Ids",
      "type": "array"
    },
    "learner_id": {
      "minLength": 1,
      "title": "Learner Id",
      "type": "string"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_at": {
      "format": "date-time",
      "title": "Selected At",
      "type": "string"
    },
    "selection_id": {
      "minLength": 1,
      "title": "Selection Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "empty",
        "selected",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "selection_id",
    "policy_id",
    "learner_id",
    "item_ids",
    "status",
    "selected_at"
  ],
  "title": "AdaptiveSelectionResult",
  "type": "object"
}
