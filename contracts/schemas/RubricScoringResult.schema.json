{
  "$defs": {
    "CriterionScore": {
      "additionalProperties": false,
      "description": "One auditable rubric-criterion decision and its evidence.",
      "properties": {
        "course_evidence_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Course Evidence Id"
        },
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "student_evidence": {
          "title": "Student Evidence",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "score",
        "student_evidence",
        "course_evidence_id",
        "reason"
      ],
      "title": "CriterionScore",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "M7 criterion-level result returned to M8 for formal audit creation.",
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "criterion_scores": {
      "items": {
        "$ref": "#/$defs/CriterionScore"
      },
      "title": "Criterion Scores",
      "type": "array"
    },
    "missing_concept_ids": {
      "items": {
        "type": "string"
      },
      "title": "Missing Concept Ids",
      "type": "array"
    },
    "model_name": {
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "model_version": {
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "review_flags": {
      "items": {
        "type": "string"
      },
      "title": "Review Flags",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scored_at": {
      "format": "date-time",
      "title": "Scored At",
      "type": "string"
    },
    "scoring_task_id": {
      "minLength": 1,
      "title": "Scoring Task Id",
      "type": "string"
    },
    "total_score": {
      "minimum": 0.0,
      "title": "Total Score",
      "type": "number"
    }
  },
  "required": [
    "scoring_task_id",
    "criterion_scores",
    "total_score",
    "confidence",
    "missing_concept_ids",
    "review_flags",
    "model_name",
    "model_version",
    "scored_at"
  ],
  "title": "RubricScoringResult",
  "type": "object"
}
