{
  "$defs": {
    "EvidenceCitation": {
      "additionalProperties": false,
      "description": "Locator-only course citation safe for current learner display.",
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "locator"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "RubricFeedback": {
      "additionalProperties": false,
      "description": "Student-facing feedback for one scoring criterion.",
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "earned_score": {
          "minimum": 0.0,
          "title": "Earned Score",
          "type": "number"
        },
        "max_score": {
          "minimum": 0.0,
          "title": "Max Score",
          "type": "number"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "student_evidence": {
          "title": "Student Evidence",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "earned_score",
        "max_score",
        "message",
        "student_evidence"
      ],
      "title": "RubricFeedback",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Citation-backed feedback safe for direct learner display.",
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence_citations": {
      "items": {
        "$ref": "#/$defs/EvidenceCitation"
      },
      "title": "Evidence Citations",
      "type": "array"
    },
    "feedback_id": {
      "minLength": 1,
      "title": "Feedback Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "learner_id": {
      "minLength": 1,
      "title": "Learner Id",
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "missing_concept_ids": {
      "items": {
        "type": "string"
      },
      "title": "Missing Concept Ids",
      "type": "array"
    },
    "next_practice_item_ids": {
      "items": {
        "type": "string"
      },
      "title": "Next Practice Item Ids",
      "type": "array"
    },
    "rubric_feedback": {
      "items": {
        "$ref": "#/$defs/RubricFeedback"
      },
      "title": "Rubric Feedback",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "feedback_id",
    "task_id",
    "learner_id",
    "message",
    "rubric_feedback",
    "missing_concept_ids",
    "evidence_citations",
    "next_practice_item_ids",
    "confidence",
    "generated_at"
  ],
  "title": "StudentFeedbackPackage",
  "type": "object"
}
