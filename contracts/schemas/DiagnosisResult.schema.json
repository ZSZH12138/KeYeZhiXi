{
  "$defs": {
    "ItemDiagnosis": {
      "additionalProperties": false,
      "description": "Diagnosis evidence and misconceptions for one attempted item.",
      "properties": {
        "concept_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "error_type": {
          "minLength": 1,
          "title": "Error Type",
          "type": "string"
        },
        "evidence_audit_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Audit Ids",
          "type": "array"
        },
        "item_instance_id": {
          "minLength": 1,
          "title": "Item Instance Id",
          "type": "string"
        },
        "misconception_ids": {
          "items": {
            "type": "string"
          },
          "title": "Misconception Ids",
          "type": "array"
        },
        "prerequisite_gap_ids": {
          "items": {
            "type": "string"
          },
          "title": "Prerequisite Gap Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "item_instance_id",
        "concept_ids",
        "misconception_ids",
        "error_type",
        "confidence",
        "evidence_audit_ids",
        "prerequisite_gap_ids"
      ],
      "title": "ItemDiagnosis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Attempt-wide diagnosis with ordered teaching priorities.",
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "diagnosis_id": {
      "minLength": 1,
      "title": "Diagnosis Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "item_diagnoses": {
      "items": {
        "$ref": "#/$defs/ItemDiagnosis"
      },
      "minItems": 1,
      "title": "Item Diagnoses",
      "type": "array"
    },
    "learner_id": {
      "minLength": 1,
      "title": "Learner Id",
      "type": "string"
    },
    "priority_concept_ids": {
      "items": {
        "type": "string"
      },
      "title": "Priority Concept Ids",
      "type": "array"
    },
    "priority_misconception_ids": {
      "items": {
        "type": "string"
      },
      "title": "Priority Misconception Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "diagnosis_id",
    "attempt_id",
    "learner_id",
    "item_diagnoses",
    "priority_concept_ids",
    "priority_misconception_ids",
    "generated_at"
  ],
  "title": "DiagnosisResult",
  "type": "object"
}
