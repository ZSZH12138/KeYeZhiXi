    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Evidence Ids",
      "type": "array"
    },
    "status": {
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "stem": {
      "minLength": 1,
      "title": "Stem",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "version",
    "stem",
    "item_type",
    "concept_ids",
    "misconception_ids",
    "difficulty_level",
    "cognitive_level",
    "parameter_rules",
    "answer_key",
    "rubric_id",
    "source_evidence_ids",
    "status"
