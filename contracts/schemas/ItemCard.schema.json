{
  "$defs": {
    "ParameterRule": {
      "additionalProperties": false,
      "description": "Bounded parameter vocabulary for a teacher-reviewed item template.",
      "properties": {
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minimum"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value_type": {
          "minLength": 1,
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value_type",
        "minimum",
        "maximum",
        "choices",
        "constraints"
      ],
      "title": "ParameterRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned course item with concept, misconception, and evidence links.",
  "properties": {
    "answer_key": {
      "additionalProperties": true,
      "title": "Answer Key",
      "type": "object"
    },
    "cognitive_level": {
      "minLength": 1,
      "title": "Cognitive Level",
      "type": "string"
    },
    "concept_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Concept Ids",
      "type": "array"
    },
    "difficulty_level": {
      "minimum": 0,
      "title": "Difficulty Level",
      "type": "integer"
    },
    "item_id": {
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "item_type": {
      "minLength": 1,
      "title": "Item Type",
      "type": "string"
    },
    "misconception_ids": {
      "items": {
        "type": "string"
      },
      "title": "Misconception Ids",
      "type": "array"
    },
    "parameter_rules": {
      "items": {
        "$ref": "#/$defs/ParameterRule"
      },
      "title": "Parameter Rules",
      "type": "array"
    },
    "rubric_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Rubric Id"
