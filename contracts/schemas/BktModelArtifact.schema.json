{
  "$defs": {
    "BktConceptParameters": {
      "additionalProperties": false,
      "description": "Four fitted BKT probabilities for one course concept.",
      "properties": {
        "concept_id": {
          "minLength": 1,
          "title": "Concept Id",
          "type": "string"
        },
        "guess": {
          "maximum": 0.4,
          "minimum": 0.01,
          "title": "Guess",
          "type": "number"
        },
        "learn": {
          "maximum": 0.4,
          "minimum": 0.01,
          "title": "Learn",
          "type": "number"
        },
        "learner_count": {
          "minimum": 1,
          "title": "Learner Count",
          "type": "integer"
        },
        "observation_count": {
          "minimum": 1,
          "title": "Observation Count",
          "type": "integer"
        },
        "prior": {
          "maximum": 0.99,
          "minimum": 0.01,
          "title": "Prior",
          "type": "number"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "slip": {
          "maximum": 0.4,
          "minimum": 0.01,
          "title": "Slip",
          "type": "number"
        }
      },
      "required": [
        "concept_id",
        "prior",
        "learn",
        "guess",
        "slip",
        "learner_count",
        "observation_count"
      ],
      "title": "BktConceptParameters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned four-parameter BKT model for one teaching scope.",
  "properties": {
    "class_id": {
      "minLength": 1,
      "title": "Class Id",
      "type": "string"
    },
    "concept_parameters": {
      "items": {
        "$ref": "#/$defs/BktConceptParameters"
      },
      "minItems": 1,
      "title": "Concept Parameters",
      "type": "array"
    },
    "converged": {
      "title": "Converged",
      "type": "boolean"
    },
    "course_id": {
      "minLength": 1,
      "title": "Course Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "iteration_count": {
      "minimum": 1,
      "title": "Iteration Count",
      "type": "integer"
    },
    "learner_count": {
      "minimum": 1,
      "title": "Learner Count",
      "type": "integer"
    },
    "log_likelihood": {
      "title": "Log Likelihood",
      "type": "number"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_version": {
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "observation_count": {
      "minimum": 1,
      "title": "Observation Count",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "model_id",
    "course_id",
    "class_id",
    "model_version",
    "concept_parameters",
    "learner_count",
    "observation_count",
    "log_likelihood",
    "iteration_count",
    "converged",
    "created_at"
  ],
  "title": "BktModelArtifact",
  "type": "object"
}
