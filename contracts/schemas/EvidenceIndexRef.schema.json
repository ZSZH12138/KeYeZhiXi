{
  "additionalProperties": false,
  "description": "Persistent identity and readiness metadata for an M2 index.",
  "properties": {
    "backend": {
      "default": "lexical",
      "enum": [
        "lexical",
        "pgvector"
      ],
      "title": "Backend",
      "type": "string"
    },
    "built_at": {
      "format": "date-time",
      "title": "Built At",
      "type": "string"
    },
    "checksum": {
      "minLength": 1,
      "title": "Checksum",
      "type": "string"
    },
    "chunk_count": {
      "minimum": 0,
      "title": "Chunk Count",
      "type": "integer"
    },
    "course_package_checksum": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Course Package Checksum"
    },
    "course_package_id": {
      "minLength": 1,
      "title": "Course Package Id",
      "type": "string"
    },
    "embedding_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedding Model Id"
    },
    "index_id": {
      "minLength": 1,
      "title": "Index Id",
      "type": "string"
    },
    "index_version": {
      "minLength": 1,
      "title": "Index Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_count": {
      "minimum": 0,
      "title": "Source Count",
      "type": "integer"
    },
    "status": {
      "enum": [
        "building",
        "ready",
        "failed",
        "empty"
      ],
      "title": "Status",
      "type": "string"
    },
    "storage_ref": {
      "minLength": 1,
      "title": "Storage Ref",
      "type": "string"
    }
  },
  "required": [
    "index_id",
    "course_package_id",
    "index_version",
    "storage_ref",
    "source_count",
    "chunk_count",
    "built_at",
    "checksum",
    "status"
  ],
  "title": "EvidenceIndexRef",
  "type": "object"
}
