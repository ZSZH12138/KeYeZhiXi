{
  "$defs": {
    "CriterionScore": {
      "additionalProperties": false,
      "description": "One auditable rubric-criterion decision and its evidence.",
      "properties": {
        "course_evidence_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Course Evidence Id"
        },
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "student_evidence": {
          "title": "Student Evidence",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "score",
        "student_evidence",
        "course_evidence_id",
        "reason"
      ],
      "title": "CriterionScore",
      "type": "object"
    },
    "LearningEvent": {
      "additionalProperties": false,
      "description": "One pseudonymous, replay-safe learning event consumed by M0.",
      "properties": {
        "attempt_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt Id"
        },
        "class_id": {
          "minLength": 1,
          "title": "Class Id",
          "type": "string"
        },
        "course_id": {
          "minLength": 1,
          "title": "Course Id",
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "course_id",
        "class_id",
        "learner_id",
        "attempt_id",
        "payload",
        "occurred_at"
      ],
      "title": "LearningEvent",
      "type": "object"
    },
    "RemediationPlan": {
      "additionalProperties": false,
      "description": "Attempt-bound ordered remediation targets produced by M8.",
      "properties": {
        "based_on_attempt_id": {
          "minLength": 1,
          "title": "Based On Attempt Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/RemediationTarget"
          },
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "plan_id",
        "based_on_attempt_id",
        "learner_id",
        "targets",
        "created_at"
      ],
      "title": "RemediationPlan",
      "type": "object"
    },
    "RemediationTarget": {
      "additionalProperties": false,
      "description": "One concept or misconception target for subsequent practice.",
      "properties": {
        "concept_id": {
          "minLength": 1,
          "title": "Concept Id",
          "type": "string"
        },
        "misconception_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Misconception Id"
        },
        "priority": {
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "recommended_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Item Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "concept_id",
        "misconception_id",
        "priority",
        "recommended_item_ids",
        "reason"
      ],
      "title": "RemediationTarget",
      "type": "object"
    },
    "ScoreAuditRecord": {
      "additionalProperties": false,
      "description": "Versioned M8 scoring record retained through teacher overrides.",
      "properties": {
        "attempt_id": {
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "audit_id": {
          "minLength": 1,
          "title": "Audit Id",
          "type": "string"
        },
        "audit_version": {
          "minimum": 1,
          "title": "Audit Version",
          "type": "integer"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "criterion_scores": {
          "items": {
            "$ref": "#/$defs/CriterionScore"
          },
          "title": "Criterion Scores",
          "type": "array"
        },
        "item_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "item_instance_id": {
          "minLength": 1,
          "title": "Item Instance Id",
          "type": "string"
        },
        "item_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Version"
        },
        "max_score": {
          "minimum": 0.0,
          "title": "Max Score",
          "type": "number"
        },
        "review_reason": {
          "items": {
            "type": "string"
          },
          "title": "Review Reason",
          "type": "array"
        },
        "review_status": {
          "minLength": 1,
          "title": "Review Status",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scoring_method": {
          "enum": [
            "rule",
            "local_model",
            "teacher_override"
          ],
          "title": "Scoring Method",
          "type": "string"
        },
        "total_score": {
          "minimum": 0.0,
          "title": "Total Score",
          "type": "number"
        }
      },
      "required": [
        "audit_id",
        "audit_version",
        "attempt_id",
        "item_instance_id",
        "criterion_scores",
        "total_score",
        "max_score",
        "confidence",
        "scoring_method",
        "review_status",
        "review_reason",
        "created_at"
      ],
      "title": "ScoreAuditRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "M8 score history with current totals and attempt-bound remediation.",
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "finalized_at": {
      "format": "date-time",
      "title": "Finalized At",
      "type": "string"
    },
    "learner_id": {
      "minLength": 1,
      "title": "Learner Id",
      "type": "string"
    },
    "learning_events": {
      "items": {
        "$ref": "#/$defs/LearningEvent"
      },
      "title": "Learning Events",
      "type": "array"
    },
    "max_score": {
      "minimum": 0.0,
      "title": "Max Score",
      "type": "number"
    },
    "paper_id": {
      "minLength": 1,
      "title": "Paper Id",
      "type": "string"
    },
    "remediation_plan": {
      "$ref": "#/$defs/RemediationPlan"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score_audit_records": {
      "items": {
        "$ref": "#/$defs/ScoreAuditRecord"
      },
      "title": "Score Audit Records",
      "type": "array"
    },
    "total_score": {
      "minimum": 0.0,
      "title": "Total Score",
      "type": "number"
    }
  },
  "required": [
    "attempt_id",
    "paper_id",
    "learner_id",
    "score_audit_records",
    "learning_events",
    "remediation_plan",
    "total_score",
    "max_score",
    "finalized_at"
  ],
  "title": "ScoringResultBundle",
  "type": "object"
}
