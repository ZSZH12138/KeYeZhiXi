{
  "$defs": {
    "CriterionOverride": {
      "additionalProperties": false,
      "description": "Auditable before-and-after score for one rubric criterion.",
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "new_score": {
          "minimum": 0.0,
          "title": "New Score",
          "type": "number"
        },
        "previous_score": {
          "minimum": 0.0,
          "title": "Previous Score",
          "type": "number"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "previous_score",
        "new_score",
        "reason"
      ],
      "title": "CriterionOverride",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Optimistically versioned teacher decision for one score audit.",
  "properties": {
    "audit_id": {
      "minLength": 1,
      "title": "Audit Id",
      "type": "string"
    },
    "criterion_overrides": {
      "items": {
        "$ref": "#/$defs/CriterionOverride"
      },
      "title": "Criterion Overrides",
      "type": "array"
    },
    "decision": {
      "enum": [
        "confirm",
        "override",
        "reject"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_id": {
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "expected_audit_checksum": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Audit Checksum",
      "type": "string"
    },
    "expected_audit_version": {
      "minimum": 1,
      "title": "Expected Audit Version",
      "type": "integer"
    },
    "final_total_score": {
      "minimum": 0.0,
      "title": "Final Total Score",
      "type": "number"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "teacher_comment": {
      "minLength": 1,
      "title": "Teacher Comment",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "audit_id",
    "expected_audit_version",
    "expected_audit_checksum",
    "decision",
    "final_total_score",
    "criterion_overrides",
    "teacher_comment",
    "reviewer_id",
    "reviewed_at"
  ],
  "title": "TeacherReviewDecision",
  "type": "object"
}
