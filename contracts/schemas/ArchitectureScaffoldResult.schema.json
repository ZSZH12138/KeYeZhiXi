          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "empty",
            "estimated",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "learner_id",
        "model_type",
        "model_version",
        "concept_probabilities",
        "observation_watermark",
        "observation_count",
        "status",
        "updated_at"
      ],
