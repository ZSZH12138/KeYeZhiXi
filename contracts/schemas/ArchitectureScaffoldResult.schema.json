{
  "$defs": {
    "AbilityEstimate": {
      "additionalProperties": false,
      "description": "Learner ability estimate bound to one IRT parameter set.",
      "properties": {
        "estimate_id": {
          "minLength": 1,
          "title": "Estimate Id",
          "type": "string"
        },
        "estimated_at": {
          "format": "date-time",
          "title": "Estimated At",
          "type": "string"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "parameter_set_id": {
          "minLength": 1,
          "title": "Parameter Set Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "standard_error": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Error"
        },
        "status": {
          "enum": [
            "empty",
            "estimated",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "theta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theta"
        }
      },
      "required": [
        "estimate_id",
        "learner_id",
        "parameter_set_id",
        "status",
        "estimated_at"
      ],
      "title": "AbilityEstimate",
      "type": "object"
    },
    "AdaptiveSelectionResult": {
      "additionalProperties": false,
      "description": "M8 item selection output; empty until IRT is configured.",
      "properties": {
        "ability_estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbilityEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Item Ids",
          "type": "array"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_at": {
          "format": "date-time",
          "title": "Selected At",
          "type": "string"
        },
        "selection_id": {
          "minLength": 1,
          "title": "Selection Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "empty",
            "selected",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "selection_id",
        "policy_id",
        "learner_id",
        "item_ids",
        "status",
        "selected_at"
      ],
      "title": "AdaptiveSelectionResult",
      "type": "object"
    },
    "AsyncJobStatus": {
      "additionalProperties": false,
      "description": "Portable status for a future M0 background job.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "job_id": {
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "job_type": {
          "enum": [
            "django_frontend",
            "vector_index",
            "llm_generation",
            "learning_model",
            "calibration"
          ],
          "title": "Job Type",
          "type": "string"
        },
        "progress": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Progress",
          "type": "number"
        },
        "result_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Ref"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "job_type",
        "status",
        "progress",
        "created_at"
      ],
      "title": "AsyncJobStatus",
      "type": "object"
    },
    "CalibrationRunResult": {
      "additionalProperties": false,
      "description": "M8 shadow-calibration result awaiting M9 review.",
      "properties": {
        "converged": {
          "title": "Converged",
          "type": "boolean"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "parameter_set": {
          "$ref": "#/$defs/IRTParameterSet"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "empty",
            "shadow",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "parameter_set",
        "converged",
        "metrics",
        "status",
        "generated_at"
      ],
      "title": "CalibrationRunResult",
      "type": "object"
    },
    "CognitiveDiagnosisResult": {
      "additionalProperties": false,
      "description": "Versioned DINA-family output; empty until the engine is configured.",
      "properties": {
        "concept_mastery": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Concept Mastery",
          "type": "object"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "model_type": {
          "enum": [
            "DINA",
            "DINO",
            "GDINA",
            "NCDM"
          ],
          "title": "Model Type",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "empty",
            "estimated",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "learner_id",
        "model_type",
        "model_version",
        "concept_mastery",
        "observation_count",
        "status",
        "generated_at"
      ],
      "title": "CognitiveDiagnosisResult",
      "type": "object"
    },
    "EvidenceIndexRef": {
      "additionalProperties": false,
      "description": "Persistent identity and readiness metadata for an M2 index.",
      "properties": {
        "backend": {
          "default": "lexical",
          "enum": [
            "lexical",
            "pgvector"
          ],
          "title": "Backend",
          "type": "string"
        },
        "built_at": {
          "format": "date-time",
          "title": "Built At",
          "type": "string"
        },
        "checksum": {
          "minLength": 1,
          "title": "Checksum",
          "type": "string"
        },
        "chunk_count": {
          "minimum": 0,
          "title": "Chunk Count",
          "type": "integer"
        },
        "course_package_id": {
          "minLength": 1,
          "title": "Course Package Id",
          "type": "string"
        },
        "embedding_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model Id"
        },
        "index_id": {
          "minLength": 1,
          "title": "Index Id",
          "type": "string"
        },
        "index_version": {
          "minLength": 1,
          "title": "Index Version",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_count": {
          "minimum": 0,
          "title": "Source Count",
          "type": "integer"
        },
        "status": {
          "enum": [
            "building",
            "ready",
            "failed",
            "empty"
          ],
          "title": "Status",
          "type": "string"
        },
        "storage_ref": {
          "minLength": 1,
          "title": "Storage Ref",
          "type": "string"
        }
      },
      "required": [
        "index_id",
        "course_package_id",
        "index_version",
        "storage_ref",
        "source_count",
        "chunk_count",
        "built_at",
        "checksum",
        "status"
      ],
      "title": "EvidenceIndexRef",
      "type": "object"
    },
    "IRTItemParameters": {
      "additionalProperties": false,
      "description": "Versioned IRT parameters for one immutable item version.",
      "properties": {
        "difficulty": {
          "title": "Difficulty",
          "type": "number"
        },
        "discrimination": {
          "exclusiveMinimum": 0.0,
          "title": "Discrimination",
          "type": "number"
        },
        "guessing": {
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Guessing",
          "type": "number"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "item_version": {
          "minLength": 1,
          "title": "Item Version",
          "type": "string"
        },
        "sample_size": {
          "minimum": 1,
          "title": "Sample Size",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "item_version",
        "discrimination",
        "difficulty",
        "guessing",
        "sample_size"
      ],
      "title": "IRTItemParameters",
      "type": "object"
    },
    "IRTParameterSet": {
      "additionalProperties": false,
      "description": "M8-owned append-only IRT parameter snapshot.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "item_parameters": {
          "items": {
            "$ref": "#/$defs/IRTItemParameters"
          },
          "title": "Item Parameters",
          "type": "array"
        },
        "model_type": {
          "enum": [
            "1PL",
            "2PL",
            "3PL"
          ],
          "title": "Model Type",
          "type": "string"
        },
        "parameter_set_id": {
          "minLength": 1,
          "title": "Parameter Set Id",
          "type": "string"
        },
        "sample_size": {
          "minimum": 0,
          "title": "Sample Size",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "empty",
            "shadow",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "parameter_set_id",
        "model_type",
        "version",
        "item_parameters",
        "sample_size",
        "status",
        "created_at"
      ],
      "title": "IRTParameterSet",
      "type": "object"
    },
