    "LLMGenerationResult": {
      "additionalProperties": false,
      "description": "Structured DeepSeek output or an explicit empty placeholder.",
      "properties": {
        "citation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Citation Ids",
          "type": "array"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
