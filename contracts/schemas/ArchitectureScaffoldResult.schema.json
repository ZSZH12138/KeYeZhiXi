        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "observation_watermark": {
          "minLength": 1,
          "title": "Observation Watermark",
          "type": "string"
