          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "provider": {
          "const": "deepseek",
          "default": "deepseek",
          "title": "Provider",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "empty",
            "succeeded",
            "failed",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "structured_output": {
          "additionalProperties": true,
          "title": "Structured Output",
          "type": "object"
