{
  "$defs": {
    "ConceptState": {
      "additionalProperties": false,
      "description": "Learner state for one course concept.",
      "properties": {
        "concept_id": {
          "minLength": 1,
          "title": "Concept Id",
          "type": "string"
        },
        "evidence_count": {
          "minimum": 0,
          "title": "Evidence Count",
          "type": "integer"
        },
        "hint_dependency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hint Dependency",
          "type": "number"
        },
        "mastery_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mastery Confidence",
          "type": "number"
        },
        "mastery_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mastery Probability",
          "type": "number"
        },
        "misconceptions": {
          "items": {
            "$ref": "#/$defs/MisconceptionStrength"
          },
          "title": "Misconceptions",
          "type": "array"
        },
        "recent_correction_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Recent Correction Rate",
          "type": "number"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "concept_id",
        "mastery_probability",
        "mastery_confidence",
        "misconceptions",
        "hint_dependency",
        "recent_correction_rate",
        "evidence_count",
        "updated_at"
      ],
      "title": "ConceptState",
      "type": "object"
    },
    "MisconceptionStrength": {
      "additionalProperties": false,
      "description": "Current evidence-weighted strength of one misconception.",
      "properties": {
        "evidence_count": {
          "minimum": 0,
          "title": "Evidence Count",
          "type": "integer"
        },
        "last_seen_at": {
          "format": "date-time",
          "title": "Last Seen At",
          "type": "string"
        },
        "misconception_id": {
          "minLength": 1,
          "title": "Misconception Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "strength": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Strength",
          "type": "number"
        }
      },
      "required": [
        "misconception_id",
        "strength",
        "evidence_count",
        "last_seen_at"
      ],
      "title": "MisconceptionStrength",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned learner-state snapshot consumed across later modules.",
  "properties": {
    "class_id": {
      "minLength": 1,
      "title": "Class Id",
      "type": "string"
    },
    "concept_states": {
      "items": {
        "$ref": "#/$defs/ConceptState"
      },
      "title": "Concept States",
      "type": "array"
    },
    "course_id": {
      "minLength": 1,
      "title": "Course Id",
      "type": "string"
    },
    "evidence_count": {
      "minimum": 0,
      "title": "Evidence Count",
      "type": "integer"
    },
    "learner_id": {
      "minLength": 1,
      "title": "Learner Id",
      "type": "string"
    },
    "overall_mastery": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Overall Mastery",
      "type": "number"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "state_version": {
      "minimum": 1,
      "title": "State Version",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "course_id",
    "class_id",
    "learner_id",
    "state_version",
    "concept_states",
    "overall_mastery",
    "evidence_count",
    "updated_at"
  ],
  "title": "LearnerStateSnapshot",
  "type": "object"
}
