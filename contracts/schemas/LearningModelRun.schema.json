{
  "$defs": {
    "CognitiveDiagnosisResult": {
      "additionalProperties": false,
      "description": "Versioned DINA-family output; empty until the engine is configured.",
      "properties": {
        "concept_mastery": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Concept Mastery",
          "type": "object"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "model_type": {
          "enum": [
            "DINA",
            "DINO",
            "GDINA",
            "NCDM"
          ],
          "title": "Model Type",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "empty",
            "estimated",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "learner_id",
        "model_type",
        "model_version",
        "concept_mastery",
        "observation_count",
        "status",
        "generated_at"
      ],
      "title": "CognitiveDiagnosisResult",
      "type": "object"
    },
    "KnowledgeTraceSnapshot": {
      "additionalProperties": false,
      "description": "Versioned BKT-family trace; empty until sequence data is available.",
      "properties": {
        "concept_probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Concept Probabilities",
          "type": "object"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "model_type": {
          "enum": [
            "BKT",
            "BKT_FORGETTING",
            "DKT"
          ],
          "title": "Model Type",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "observation_watermark": {
          "minLength": 1,
          "title": "Observation Watermark",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "empty",
            "estimated",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "learner_id",
        "model_type",
        "model_version",
        "concept_probabilities",
        "observation_watermark",
        "observation_count",
        "status",
        "updated_at"
      ],
      "title": "KnowledgeTraceSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Atomic M5 DINA and BKT placeholder run.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "diagnosis": {
      "$ref": "#/$defs/CognitiveDiagnosisResult"
    },
    "knowledge_trace": {
      "$ref": "#/$defs/KnowledgeTraceSnapshot"
    },
    "observation_count": {
      "minimum": 0,
      "title": "Observation Count",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "empty",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "diagnosis",
    "knowledge_trace",
    "observation_count",
    "status",
    "created_at"
  ],
  "title": "LearningModelRun",
  "type": "object"
}
