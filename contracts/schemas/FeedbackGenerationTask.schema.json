{
  "$defs": {
    "DiagnosisResult": {
      "additionalProperties": false,
      "description": "Attempt-wide diagnosis with ordered teaching priorities.",
      "properties": {
        "attempt_id": {
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "diagnosis_id": {
          "minLength": 1,
          "title": "Diagnosis Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "item_diagnoses": {
          "items": {
            "$ref": "#/$defs/ItemDiagnosis"
          },
          "minItems": 1,
          "title": "Item Diagnoses",
          "type": "array"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "priority_concept_ids": {
          "items": {
            "type": "string"
          },
          "title": "Priority Concept Ids",
          "type": "array"
        },
        "priority_misconception_ids": {
          "items": {
            "type": "string"
          },
          "title": "Priority Misconception Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "diagnosis_id",
        "attempt_id",
        "learner_id",
        "item_diagnoses",
        "priority_concept_ids",
        "priority_misconception_ids",
        "generated_at"
      ],
      "title": "DiagnosisResult",
      "type": "object"
    },
    "ItemDiagnosis": {
      "additionalProperties": false,
      "description": "Diagnosis evidence and misconceptions for one attempted item.",
      "properties": {
        "concept_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "error_type": {
          "minLength": 1,
          "title": "Error Type",
          "type": "string"
        },
        "evidence_audit_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Audit Ids",
          "type": "array"
        },
        "item_instance_id": {
          "minLength": 1,
          "title": "Item Instance Id",
          "type": "string"
        },
        "misconception_ids": {
          "items": {
            "type": "string"
          },
          "title": "Misconception Ids",
          "type": "array"
        },
        "prerequisite_gap_ids": {
          "items": {
            "type": "string"
          },
          "title": "Prerequisite Gap Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "item_instance_id",
        "concept_ids",
        "misconception_ids",
        "error_type",
        "confidence",
        "evidence_audit_ids",
        "prerequisite_gap_ids"
      ],
      "title": "ItemDiagnosis",
      "type": "object"
    },
    "TeachingAction": {
      "additionalProperties": false,
      "description": "One auditable action selected by the tutoring controller.",
      "properties": {
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "action_type": {
          "minLength": 1,
          "title": "Action Type",
          "type": "string"
        },
        "must_not_reveal_answer": {
          "title": "Must Not Reveal Answer",
          "type": "boolean"
        },
        "next_state": {
          "minLength": 1,
          "title": "Next State",
          "type": "string"
        },
        "prompt_template_id": {
          "minLength": 1,
          "title": "Prompt Template Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state_before": {
          "minLength": 1,
          "title": "State Before",
          "type": "string"
        },
        "target_concept_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Concept Ids",
          "type": "array"
        }
      },
      "required": [
        "action_id",
        "state_before",
        "action_type",
        "target_concept_ids",
        "prompt_template_id",
        "must_not_reveal_answer",
        "next_state",
        "reason"
      ],
      "title": "TeachingAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Evidence-bound local feedback generation request.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "diagnosis_result": {
      "$ref": "#/$defs/DiagnosisResult"
    },
    "evidence_query_id": {
      "minLength": 1,
      "title": "Evidence Query Id",
      "type": "string"
    },
    "feedback_task_id": {
      "minLength": 1,
      "title": "Feedback Task Id",
      "type": "string"
    },
    "learner_id": {
      "minLength": 1,
      "title": "Learner Id",
      "type": "string"
    },
    "learner_state_snapshot_id": {
      "minLength": 1,
      "title": "Learner State Snapshot Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score_summary": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Score Summary",
      "type": "object"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "teaching_action": {
      "$ref": "#/$defs/TeachingAction"
    }
  },
  "required": [
    "feedback_task_id",
    "task_id",
    "learner_id",
    "teaching_action",
    "diagnosis_result",
    "score_summary",
    "learner_state_snapshot_id",
    "evidence_query_id",
    "created_at"
  ],
  "title": "FeedbackGenerationTask",
  "type": "object"
}
