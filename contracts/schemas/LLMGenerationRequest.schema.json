{
  "$defs": {
    "LLMModelRef": {
      "additionalProperties": false,
      "description": "DeepSeek-only model declaration with an environment-key name.",
      "properties": {
        "api_key_env": {
          "const": "DEEPSEEK_API_KEY",
          "default": "DEEPSEEK_API_KEY",
          "title": "Api Key Env",
          "type": "string"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "provider": {
          "const": "deepseek",
          "default": "deepseek",
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "empty",
            "configured"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "model_name",
        "model_version",
        "status"
      ],
      "title": "LLMModelRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Hashed, evidence-scoped request for M7 or M9 DeepSeek generation.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "input_checksum": {
      "minLength": 1,
      "title": "Input Checksum",
      "type": "string"
    },
    "model_ref": {
      "$ref": "#/$defs/LLMModelRef"
    },
    "prompt_template_id": {
      "minLength": 1,
      "title": "Prompt Template Id",
      "type": "string"
    },
    "prompt_template_version": {
      "minLength": 1,
      "title": "Prompt Template Version",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "use_case": {
      "enum": [
        "rubric_scoring",
        "student_feedback",
        "teacher_narrative"
      ],
      "title": "Use Case",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "use_case",
    "model_ref",
    "prompt_template_id",
    "prompt_template_version",
    "evidence_ids",
    "input_checksum",
    "created_at"
  ],
  "title": "LLMGenerationRequest",
  "type": "object"
}
