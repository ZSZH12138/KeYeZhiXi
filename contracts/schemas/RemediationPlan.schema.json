{
  "$defs": {
    "RemediationTarget": {
      "additionalProperties": false,
      "description": "One concept or misconception target for subsequent practice.",
      "properties": {
        "concept_id": {
          "minLength": 1,
          "title": "Concept Id",
          "type": "string"
        },
        "misconception_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Misconception Id"
        },
        "priority": {
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "recommended_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Item Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "concept_id",
        "misconception_id",
        "priority",
        "recommended_item_ids",
        "reason"
      ],
      "title": "RemediationTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Attempt-bound ordered remediation targets produced by M8.",
  "properties": {
    "based_on_attempt_id": {
      "minLength": 1,
      "title": "Based On Attempt Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "learner_id": {
      "minLength": 1,
      "title": "Learner Id",
      "type": "string"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/RemediationTarget"
      },
      "title": "Targets",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "based_on_attempt_id",
    "learner_id",
    "targets",
    "created_at"
  ],
  "title": "RemediationPlan",
  "type": "object"
}
