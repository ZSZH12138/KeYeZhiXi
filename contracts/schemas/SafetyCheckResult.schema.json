{
  "additionalProperties": false,
  "description": "M7/M9 safety filter outcome without retaining prompt content.",
  "properties": {
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "flags": {
      "items": {
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "not_run",
        "passed",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "status",
    "flags",
    "checked_at"
  ],
  "title": "SafetyCheckResult",
  "type": "object"
}
