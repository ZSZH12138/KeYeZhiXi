{
  "$defs": {
    "DiagnosisResult": {
      "additionalProperties": false,
      "description": "Attempt-wide diagnosis with ordered teaching priorities.",
      "properties": {
        "attempt_id": {
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "diagnosis_id": {
          "minLength": 1,
          "title": "Diagnosis Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "item_diagnoses": {
          "items": {
            "$ref": "#/$defs/ItemDiagnosis"
          },
          "minItems": 1,
          "title": "Item Diagnoses",
          "type": "array"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "priority_concept_ids": {
          "items": {
            "type": "string"
          },
          "title": "Priority Concept Ids",
          "type": "array"
        },
        "priority_misconception_ids": {
          "items": {
            "type": "string"
          },
          "title": "Priority Misconception Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "diagnosis_id",
        "attempt_id",
        "learner_id",
        "item_diagnoses",
        "priority_concept_ids",
        "priority_misconception_ids",
        "generated_at"
      ],
      "title": "DiagnosisResult",
      "type": "object"
    },
    "EvidenceQuery": {
      "additionalProperties": false,
      "description": "Bounded evidence request produced by M6 or M8.",
      "properties": {
        "concept_ids": {
          "items": {
            "type": "string"
          },
          "title": "Concept Ids",
          "type": "array"
        },
        "course_package_checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Course Package Checksum"
        },
        "course_package_id": {
          "minLength": 1,
          "title": "Course Package Id",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Item Id"
        },
        "min_relevance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Relevance",
          "type": "number"
        },
        "query_id": {
          "minLength": 1,
          "title": "Query Id",
          "type": "string"
        },
        "query_text": {
          "minLength": 1,
          "title": "Query Text",
          "type": "string"
        },
        "required_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Required Evidence Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "top_k": {
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "use_case": {
          "enum": [
            "grading",
            "feedback",
            "qa"
          ],
          "title": "Use Case",
          "type": "string"
        }
      },
      "required": [
        "query_id",
        "course_package_id",
        "query_text",
        "concept_ids",
        "item_id",
        "use_case",
        "top_k",
        "min_relevance"
      ],
      "title": "EvidenceQuery",
      "type": "object"
    },
    "FeedbackGenerationTask": {
      "additionalProperties": false,
      "description": "Evidence-bound local feedback generation request.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "diagnosis_result": {
          "$ref": "#/$defs/DiagnosisResult"
        },
        "evidence_query_id": {
          "minLength": 1,
          "title": "Evidence Query Id",
          "type": "string"
        },
        "feedback_task_id": {
          "minLength": 1,
          "title": "Feedback Task Id",
          "type": "string"
        },
        "learner_id": {
          "minLength": 1,
          "title": "Learner Id",
          "type": "string"
        },
        "learner_state_snapshot_id": {
          "minLength": 1,
          "title": "Learner State Snapshot Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score_summary": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Score Summary",
          "type": "object"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "teaching_action": {
          "$ref": "#/$defs/TeachingAction"
        }
      },
      "required": [
        "feedback_task_id",
        "task_id",
        "learner_id",
        "teaching_action",
        "diagnosis_result",
        "score_summary",
        "learner_state_snapshot_id",
        "evidence_query_id",
        "created_at"
      ],
      "title": "FeedbackGenerationTask",
      "type": "object"
    },
    "ItemDiagnosis": {
      "additionalProperties": false,
      "description": "Diagnosis evidence and misconceptions for one attempted item.",
      "properties": {
        "concept_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "error_type": {
          "minLength": 1,
          "title": "Error Type",
          "type": "string"
        },
        "evidence_audit_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Audit Ids",
          "type": "array"
        },
        "item_instance_id": {
          "minLength": 1,
          "title": "Item Instance Id",
          "type": "string"
        },
        "misconception_ids": {
          "items": {
            "type": "string"
          },
          "title": "Misconception Ids",
          "type": "array"
        },
        "prerequisite_gap_ids": {
          "items": {
            "type": "string"
          },
          "title": "Prerequisite Gap Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "item_instance_id",
        "concept_ids",
        "misconception_ids",
        "error_type",
        "confidence",
        "evidence_audit_ids",
        "prerequisite_gap_ids"
      ],
      "title": "ItemDiagnosis",
      "type": "object"
    },
    "SessionStateSnapshot": {
      "additionalProperties": false,
      "description": "Mutable session cursor constrained by the exact tutoring FSM.",
      "properties": {
        "completed_action_ids": {
          "items": {
            "type": "string"
          },
          "title": "Completed Action Ids",
          "type": "array"
        },
        "current_state": {
          "enum": [
            "S0",
            "S1",
            "S2",
            "S3",
            "S4",
            "S5"
          ],
          "title": "Current State",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "turn_count": {
          "minimum": 0,
          "title": "Turn Count",
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "current_state",
        "turn_count",
        "completed_action_ids",
        "updated_at"
      ],
      "title": "SessionStateSnapshot",
      "type": "object"
    },
    "TeachingAction": {
      "additionalProperties": false,
      "description": "One auditable action selected by the tutoring controller.",
      "properties": {
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "action_type": {
          "minLength": 1,
          "title": "Action Type",
          "type": "string"
        },
        "must_not_reveal_answer": {
          "title": "Must Not Reveal Answer",
          "type": "boolean"
        },
        "next_state": {
          "minLength": 1,
          "title": "Next State",
          "type": "string"
        },
        "prompt_template_id": {
          "minLength": 1,
          "title": "Prompt Template Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state_before": {
          "minLength": 1,
          "title": "State Before",
          "type": "string"
        },
        "target_concept_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Concept Ids",
          "type": "array"
        }
      },
      "required": [
        "action_id",
        "state_before",
        "action_type",
        "target_concept_ids",
        "prompt_template_id",
        "must_not_reveal_answer",
        "next_state",
        "reason"
      ],
      "title": "TeachingAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Controller output joining action, feedback task, query, and session.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_query": {
      "$ref": "#/$defs/EvidenceQuery"
    },
    "feedback_generation_task": {
      "$ref": "#/$defs/FeedbackGenerationTask"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_state_snapshot": {
      "$ref": "#/$defs/SessionStateSnapshot"
    },
    "teaching_action": {
      "$ref": "#/$defs/TeachingAction"
    }
  },
  "required": [
    "teaching_action",
    "feedback_generation_task",
    "evidence_query",
    "session_state_snapshot",
    "created_at"
  ],
  "title": "TutoringControlResult",
  "type": "object"
}
