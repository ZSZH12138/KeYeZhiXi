{
  "additionalProperties": false,
  "description": "Portable status for a future M0 background job.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "job_type": {
      "enum": [
        "django_frontend",
        "vector_index",
        "llm_generation",
        "learning_model",
        "calibration"
      ],
      "title": "Job Type",
      "type": "string"
    },
    "progress": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Progress",
      "type": "number"
    },
    "result_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Ref"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "job_type",
    "status",
    "progress",
    "created_at"
  ],
  "title": "AsyncJobStatus",
  "type": "object"
}
