{
  "additionalProperties": false,
  "description": "Bounded evidence request produced by M6 or M8.",
  "properties": {
    "concept_ids": {
      "items": {
        "type": "string"
      },
      "title": "Concept Ids",
      "type": "array"
    },
    "course_package_checksum": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Course Package Checksum"
    },
    "course_package_id": {
      "minLength": 1,
      "title": "Course Package Id",
      "type": "string"
    },
    "item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Item Id"
    },
    "min_relevance": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Min Relevance",
      "type": "number"
    },
    "query_id": {
      "minLength": 1,
      "title": "Query Id",
      "type": "string"
    },
    "query_text": {
      "minLength": 1,
      "title": "Query Text",
      "type": "string"
    },
    "required_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Required Evidence Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "top_k": {
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    },
    "use_case": {
      "enum": [
        "grading",
        "feedback",
        "qa"
      ],
      "title": "Use Case",
      "type": "string"
    }
  },
  "required": [
    "query_id",
    "course_package_id",
    "query_text",
    "concept_ids",
    "item_id",
    "use_case",
    "top_k",
    "min_relevance"
  ],
  "title": "EvidenceQuery",
  "type": "object"
}
