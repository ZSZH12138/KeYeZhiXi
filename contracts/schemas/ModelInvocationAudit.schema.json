{
  "additionalProperties": false,
  "description": "Privacy-safe M7/M9 model-call audit metadata.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "invocation_id": {
      "minLength": 1,
      "title": "Invocation Id",
      "type": "string"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "model_name": {
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "provider": {
      "const": "deepseek",
      "default": "deepseek",
      "title": "Provider",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "not_run",
        "succeeded",
        "failed",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "invocation_id",
    "request_id",
    "model_name",
    "status",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "created_at"
  ],
  "title": "ModelInvocationAudit",
  "type": "object"
}
