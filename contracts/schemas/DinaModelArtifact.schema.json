{
  "$defs": {
    "DinaItemParameters": {
      "additionalProperties": false,
      "description": "DINA slip and guess estimates for one immutable item version.",
      "properties": {
        "concept_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "guess": {
          "maximum": 0.4,
          "minimum": 0.01,
          "title": "Guess",
          "type": "number"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "item_version": {
          "minLength": 1,
          "title": "Item Version",
          "type": "string"
        },
        "sample_size": {
          "minimum": 1,
          "title": "Sample Size",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "slip": {
          "maximum": 0.4,
          "minimum": 0.01,
          "title": "Slip",
          "type": "number"
        }
      },
      "required": [
        "item_id",
        "item_version",
        "concept_ids",
        "slip",
        "guess",
        "sample_size"
      ],
      "title": "DinaItemParameters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned fitted DINA model for one course and class scope.",
  "properties": {
    "attribute_priors": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Attribute Priors",
      "type": "object"
    },
    "class_id": {
      "minLength": 1,
      "title": "Class Id",
      "type": "string"
    },
    "concept_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Concept Ids",
      "type": "array"
    },
    "converged": {
      "title": "Converged",
      "type": "boolean"
    },
    "course_id": {
      "minLength": 1,
      "title": "Course Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "elbo": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elbo"
    },
    "inference_mode": {
      "enum": [
        "exact",
        "variational"
      ],
      "title": "Inference Mode",
      "type": "string"
    },
    "item_parameters": {
      "items": {
        "$ref": "#/$defs/DinaItemParameters"
      },
      "minItems": 1,
      "title": "Item Parameters",
      "type": "array"
    },
    "iteration_count": {
      "minimum": 1,
      "title": "Iteration Count",
      "type": "integer"
    },
    "learner_count": {
      "minimum": 1,
      "title": "Learner Count",
      "type": "integer"
    },
    "log_likelihood": {
      "title": "Log Likelihood",
      "type": "number"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_version": {
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "objective_history": {
      "items": {
        "type": "number"
      },
      "title": "Objective History",
      "type": "array"
    },
    "observation_count": {
      "minimum": 1,
      "title": "Observation Count",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "model_id",
    "course_id",
    "class_id",
    "model_version",
    "concept_ids",
    "item_parameters",
    "attribute_priors",
    "learner_count",
    "observation_count",
    "inference_mode",
    "log_likelihood",
    "iteration_count",
    "converged",
    "created_at"
  ],
  "title": "DinaModelArtifact",
  "type": "object"
}
