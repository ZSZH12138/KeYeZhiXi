{
  "$defs": {
    "ClassConceptStatus": {
      "additionalProperties": false,
      "description": "Aggregated class evidence for one concept.",
      "properties": {
        "concept_id": {
          "minLength": 1,
          "title": "Concept Id",
          "type": "string"
        },
        "mastery_distribution": {
          "$ref": "#/$defs/MasteryDistribution"
        },
        "mastery_trend_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mastery Trend Delta"
        },
        "mean_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Confidence",
          "type": "number"
        },
        "mean_mastery_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Mastery Probability",
          "type": "number"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trend_comparable": {
          "title": "Trend Comparable",
          "type": "boolean"
        }
      },
      "required": [
        "concept_id",
        "mastery_distribution",
        "mean_mastery_probability",
        "mean_confidence",
        "mastery_trend_delta",
        "trend_comparable",
        "sample_count"
      ],
      "title": "ClassConceptStatus",
      "type": "object"
    },
    "ClassMisconceptionSummary": {
      "additionalProperties": false,
      "description": "Aggregated prevalence of one misconception in assessed learners.",
      "properties": {
        "affected_count": {
          "minimum": 0,
          "title": "Affected Count",
          "type": "integer"
        },
        "affected_rate_among_assessed": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Affected Rate Among Assessed",
          "type": "number"
        },
        "evidence_attempts": {
          "minimum": 0,
          "title": "Evidence Attempts",
          "type": "integer"
        },
        "misconception_id": {
          "minLength": 1,
          "title": "Misconception Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "misconception_id",
        "affected_count",
        "affected_rate_among_assessed",
        "evidence_attempts"
      ],
      "title": "ClassMisconceptionSummary",
      "type": "object"
    },
    "MasteryDistribution": {
      "additionalProperties": false,
      "description": "Normalized class proportions across the three mastery bands.",
      "properties": {
        "consolidating": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Consolidating",
          "type": "number"
        },
        "mastered": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mastered",
          "type": "number"
        },
        "priority_support": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Priority Support",
          "type": "number"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "mastered",
        "consolidating",
        "priority_support"
      ],
      "title": "MasteryDistribution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Teacher-facing class report with explicit evidence coverage.",
  "properties": {
    "class_id": {
      "minLength": 1,
      "title": "Class Id",
      "type": "string"
    },
    "concept_summaries": {
      "items": {
        "$ref": "#/$defs/ClassConceptStatus"
      },
      "title": "Concept Summaries",
      "type": "array"
    },
    "coverage_rate": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Coverage Rate",
      "type": "number"
    },
    "evidence_status": {
      "minLength": 1,
      "title": "Evidence Status",
      "type": "string"
    },
    "misconception_summaries": {
      "items": {
        "$ref": "#/$defs/ClassMisconceptionSummary"
      },
      "title": "Misconception Summaries",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score_statistics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Score Statistics",
      "type": "object"
    }
  },
  "required": [
    "class_id",
    "coverage_rate",
    "concept_summaries",
    "misconception_summaries",
    "score_statistics",
    "evidence_status"
  ],
  "title": "ClassReport",
  "type": "object"
}
