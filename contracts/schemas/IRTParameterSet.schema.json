{
  "$defs": {
    "IRTItemParameters": {
      "additionalProperties": false,
      "description": "Versioned IRT parameters for one immutable item version.",
      "properties": {
        "difficulty": {
          "title": "Difficulty",
          "type": "number"
        },
        "discrimination": {
          "exclusiveMinimum": 0.0,
          "title": "Discrimination",
          "type": "number"
        },
        "guessing": {
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Guessing",
          "type": "number"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "item_version": {
          "minLength": 1,
          "title": "Item Version",
          "type": "string"
        },
        "sample_size": {
          "minimum": 1,
          "title": "Sample Size",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "item_version",
        "discrimination",
        "difficulty",
        "guessing",
        "sample_size"
      ],
      "title": "IRTItemParameters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "M8-owned append-only IRT parameter snapshot.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "item_parameters": {
      "items": {
        "$ref": "#/$defs/IRTItemParameters"
      },
      "title": "Item Parameters",
      "type": "array"
    },
    "model_type": {
      "enum": [
        "1PL",
        "2PL",
        "3PL"
      ],
      "title": "Model Type",
      "type": "string"
    },
    "parameter_set_id": {
      "minLength": 1,
      "title": "Parameter Set Id",
      "type": "string"
    },
    "sample_size": {
      "minimum": 0,
      "title": "Sample Size",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "empty",
        "shadow",
        "approved",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "parameter_set_id",
    "model_type",
    "version",
    "item_parameters",
    "sample_size",
    "status",
    "created_at"
  ],
  "title": "IRTParameterSet",
  "type": "object"
}
