{
  "environment": "development",
  "runtime_dir": "runtime",
  "config_dir": "config",
  "database": {
    "backend": "sqlite",
    "sqlite_path": "runtime/course_insight.db",
    "url_env": "DATABASE_URL",
    "pool_min_size": 1,
    "pool_max_size": 10,
    "connect_timeout_seconds": 10.0
  },
  "ocr": {
    "backend": "disabled",
    "executable": null,
    "language": "chi_sim+eng",
    "dpi": 200,
    "timeout_seconds": 30.0,
    "max_output_bytes": 2097152
  },
  "logging": {
    "level": "INFO",
    "mode": "rotating_file",
    "directory": "logs",
    "filename": "app.log",
    "rotation_max_bytes": 10485760,
    "backup_count": 5
  },
  "outbox": {
    "batch_size": 100,
    "poll_interval_seconds": 1.0,
    "lease_seconds": 30.0,
    "max_retries": 8,
    "retry_base_seconds": 1.0,
    "retry_max_seconds": 300.0,
    "retry_jitter_ratio": 0.2,
    "heartbeat_interval_seconds": 10.0
  },
  "web": {
    "secret_key_env": "DJANGO_SECRET_KEY",
    "allowed_hosts_env": "DJANGO_ALLOWED_HOSTS",
    "csrf_trusted_origins_env": "DJANGO_CSRF_TRUSTED_ORIGINS",
    "allowed_hosts": [
      "localhost",
      "127.0.0.1"
    ],
    "csrf_trusted_origins": [],
    "secure_cookie": false,
    "session_timeout_seconds": 3600
  },
  "security": {
    "session_cookie_httponly": true,
    "session_cookie_samesite": "Lax",
    "max_request_body_bytes": 1048576,
    "max_upload_request_body_bytes": 5385486336,
    "login_failure_limit": 5,
    "login_failure_window_seconds": 300
  },
  "m6_policy": {
    "mode": "rules",
    "policy_id": null,
    "evaluation_dataset_identity": null,
    "rollout_percentage": 0.0,
    "exploration_rate": 0.0,
    "maximum_exploration_rate": 0.05,
    "gate_policy_version": "m6-active-gate-v1",
    "global_kill_switch": false,
    "allowed_course_ids": [],
    "allowed_class_ids": [],
    "minimum_support": 1,
    "maximum_uncertainty": 0.0,
    "runtime_directory": "m6_policy"
  },
  "intent": {
    "mode": "rules",
    "backend": "none",
    "model_ref": null,
    "model_id": null,
    "model_version": null,
    "model_sha256": null,
    "policy_version": "m4-intent-policy-v1",
    "min_confidence": 0.7,
    "min_margin": 0.1,
    "fallback_to_rules": true,
    "fail_closed": true
  }
}
