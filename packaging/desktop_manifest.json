{
  "formatVersion": 1,
  "appName": "KeYeZhiXi",
  "entrypoint": "src/course_insight/desktop/__main__.py",
  "mode": "onedir",
  "contentsDirectory": "_internal",
  "nativeRuntimeLibraries": [
    "ffi.dll",
    "sqlite3.dll",
    "tcl86t.dll",
    "tk86t.dll"
  ],
  "resources": [
    {
      "source": "config/app.example.json",
      "destination": "config"
    },
    {
      "source": "config/state.json",
      "destination": "config"
    },
    {
      "source": "config/teacher.json",
      "destination": "config"
    }
  ],
  "forbiddenPaths": [
    ".env",
    "config/app.json",
    "config/roles.csv",
    "runtime"
  ]
}
