# Copy to .env. Never commit real secret values.
COURSE_INSIGHT_ENVIRONMENT=development
COURSE_INSIGHT_RUNTIME_DIR=runtime
COURSE_INSIGHT_CONFIG_DIR=config
COURSE_INSIGHT_DATABASE__BACKEND=sqlite
COURSE_INSIGHT_DATABASE__SQLITE_PATH=runtime/course_insight.db
COURSE_INSIGHT_LOGGING__LEVEL=INFO
COURSE_INSIGHT_LOGGING__MODE=rotating_file
COURSE_INSIGHT_OUTBOX__BATCH_SIZE=100
COURSE_INSIGHT_OUTBOX__POLL_INTERVAL_SECONDS=1.0
COURSE_INSIGHT_OUTBOX__LEASE_SECONDS=30.0
COURSE_INSIGHT_OUTBOX__MAX_RETRIES=8
COURSE_INSIGHT_OUTBOX__RETRY_BASE_SECONDS=1.0
COURSE_INSIGHT_OUTBOX__RETRY_MAX_SECONDS=300.0
COURSE_INSIGHT_OUTBOX__RETRY_JITTER_RATIO=0.2
COURSE_INSIGHT_OUTBOX__HEARTBEAT_INTERVAL_SECONDS=10.0
DATABASE_URL=
COURSE_INSIGHT_TEST_DATABASE_URL=
COURSE_INSIGHT_TEST_DATABASE_NAME=
# Live PostgreSQL integration tests are destructive.
# Use a disposable database name that matches the DSN exactly
# and contains at least one marker such as test, ci, or tmp.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
