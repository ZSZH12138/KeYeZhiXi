# Copy to .env. Never commit real secret values.
COURSE_INSIGHT_ENVIRONMENT=development
COURSE_INSIGHT_RUNTIME_DIR=runtime
COURSE_INSIGHT_CONFIG_DIR=config
COURSE_INSIGHT_DATABASE__BACKEND=sqlite
COURSE_INSIGHT_DATABASE__SQLITE_PATH=runtime/course_insight.db
COURSE_INSIGHT_EMBEDDING__BACKEND=disabled
# Application retrieval policy (lexical is the safe offline default).
COURSE_INSIGHT_RETRIEVAL__POLICY_ID=application-lexical-v1
COURSE_INSIGHT_RETRIEVAL__STRATEGY=lexical
COURSE_INSIGHT_RETRIEVAL__TOP_K=3
COURSE_INSIGHT_RETRIEVAL__LEXICAL_WEIGHT=1.0
COURSE_INSIGHT_RETRIEVAL__VECTOR_WEIGHT=0.0
COURSE_INSIGHT_RETRIEVAL__RERANK=false
# Production vector retrieval example:
# COURSE_INSIGHT_EMBEDDING__BACKEND=openai_compatible
# COURSE_INSIGHT_EMBEDDING__ENDPOINT=https://embedding.example.com
# COURSE_INSIGHT_EMBEDDING__API_KEY_ENV=OPENAI_API_KEY
# COURSE_INSIGHT_EMBEDDING__MODEL_NAME=text-embedding-model
# COURSE_INSIGHT_EMBEDDING__MODEL_VERSION=2026-01
# COURSE_INSIGHT_EMBEDDING__DIMENSION=1536
# COURSE_INSIGHT_EMBEDDING__TIMEOUT_SECONDS=10.0
# COURSE_INSIGHT_EMBEDDING__MAX_RETRIES=2
# COURSE_INSIGHT_EMBEDDING__VERIFY_TLS=true
COURSE_INSIGHT_LOGGING__LEVEL=INFO
COURSE_INSIGHT_LOGGING__MODE=rotating_file
COURSE_INSIGHT_OUTBOX__BATCH_SIZE=100
COURSE_INSIGHT_OUTBOX__POLL_INTERVAL_SECONDS=1.0
COURSE_INSIGHT_OUTBOX__LEASE_SECONDS=30.0
COURSE_INSIGHT_OUTBOX__MAX_RETRIES=8
COURSE_INSIGHT_OUTBOX__RETRY_BASE_SECONDS=1.0
COURSE_INSIGHT_OUTBOX__RETRY_MAX_SECONDS=300.0
COURSE_INSIGHT_OUTBOX__RETRY_JITTER_RATIO=0.2
COURSE_INSIGHT_OUTBOX__HEARTBEAT_INTERVAL_SECONDS=10.0
COURSE_INSIGHT_M6_POLICY__MODE=rules
COURSE_INSIGHT_M6_POLICY__POLICY_ID=null
COURSE_INSIGHT_M6_POLICY__EVALUATION_DATASET_IDENTITY=null
COURSE_INSIGHT_M6_POLICY__ROLLOUT_PERCENTAGE=0.0
COURSE_INSIGHT_M6_POLICY__EXPLORATION_RATE=0.0
COURSE_INSIGHT_M6_POLICY__MAXIMUM_EXPLORATION_RATE=0.05
COURSE_INSIGHT_M6_POLICY__GATE_POLICY_VERSION=m6-active-gate-v1
COURSE_INSIGHT_M6_POLICY__GLOBAL_KILL_SWITCH=false
COURSE_INSIGHT_M6_POLICY__ALLOWED_COURSE_IDS=[]
COURSE_INSIGHT_M6_POLICY__ALLOWED_CLASS_IDS=[]
COURSE_INSIGHT_M6_POLICY__MINIMUM_SUPPORT=1
COURSE_INSIGHT_M6_POLICY__MAXIMUM_UNCERTAINTY=0.0
COURSE_INSIGHT_M6_POLICY__RUNTIME_DIRECTORY=m6_policy
DATABASE_URL=
COURSE_INSIGHT_TEST_DATABASE_URL=
COURSE_INSIGHT_TEST_DATABASE_NAME=
# Live PostgreSQL integration tests are destructive.
# Use a disposable database name that matches the DSN exactly
# and contains at least one marker such as test, ci, or tmp.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional legacy/shared DeepSeek adapters only. Current course/class features
# store a scoped key from the teacher UI instead of reading this value.
DEEPSEEK_API_KEY=
# Optional OpenAI-compatible embedding provider configured above.
OPENAI_API_KEY=
